# Python
src/engine/.venv/
src/engine/__pycache__/
**/__pycache__/
*.pyc
src/engine/*.egg-info/
src/engine/.coverage
src/engine/.ruff_cache/

# Locally downloaded models (large, re-downloaded on demand)
src/engine/ov-models/

# Per-machine, git-ignored configuration and state (contains real device names, names,
# and jargon -- see src/engine/_hotwords.py and scripts/_Common.ps1).
# devices.local.json is written by scripts/Set-AudioDevices.ps1 into scripts/, not
# src/engine/ -- this entry pointed at the wrong path until 2026-10-09, found while
# wiring the .NET orchestrator's own device resolution into the same file.
scripts/devices.local.json
src/engine/hotwords.local.json
src/engine/hotwords_candidates.local.json

# Recordings and transcripts produced by running the tool
recordings/
*.wav
*.dictate.txt
*.live.txt

# .NET
**/bin/
**/obj/
*.user
TestResults/
coverage/

# Velopack release build output (release.yml's local equivalent) -- never committed, a
# release lives in GitHub Releases, not in this repo
publish/
releases/

# Editor/OS noise
.vs/
.idea/
*.swp
Thumbs.db
