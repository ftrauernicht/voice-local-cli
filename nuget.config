<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    <clear /> drops whatever sources the machine happens to have configured, so a restore
    resolves against the sources named here and nowhere else.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Every package must come from a source that claims it by pattern. With one source the
    "*" pattern is a formality — its value is that adding an internal feed later forces an
    explicit decision about which packages it may serve, instead of silently shadowing a
    public package with the same name (dependency-confusion protection).
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
