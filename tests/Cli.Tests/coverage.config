<?xml version="1.0" encoding="utf-8"?>
<!--
  Excludes the real OS/process glue (Win32 P/Invoke, System.Diagnostics.Process) and the
  Spectre.Console composition root from the coverage percentage. Both are deliberately
  tested against fakes (IProcessLauncher/IChildProcess, see
  tests/Cli.Tests/VoiceLocalCli.Application.Tests), not exercised directly; counting their
  uninstrumented lines against the 85% gate would make the number meaningless rather than
  strict. This mirrors the testability boundary src/engine/TESTING.md draws for the Python
  side's real hardware paths.

  No literal double hyphen inside this comment block: that is invalid XML and makes the
  coverage extension fail to parse the file silently (observed directly while writing this
  file: "Zero tests ran", exit code 5, no error message pointing at the cause).
-->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Exclude>
        <ModulePath>.*VoiceLocalCli\.Infrastructure\.dll$</ModulePath>
        <ModulePath>.*VoiceLocalCli\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
